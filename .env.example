GOOGLE_GENERATIVE_AI_API_KEY=
NC_EXTRACT_MODEL=gemini-3.5-flash
NC_CHAT_MODEL=gemini-3.5-flash
NC_EXTRACT_FALLBACK_MODEL=gemini-3.5-flash-lite
NC_CHAT_FALLBACK_MODEL=gemini-3.5-flash-lite
# Razonamiento de la extracción: low o medium (por defecto).
NC_EXTRACT_THINKING=medium
# Límite aproximado por IP y por instancia (por defecto 8 y 40).
NC_EXTRACT_PER_HOUR=8
NC_CHAT_PER_HOUR=40
